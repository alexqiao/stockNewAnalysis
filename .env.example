DATABASE_URL=sqlite:///./data/trade_news.db
LLM_BASE_URL=https://openrouter.ai/api/v1
# 填写 OpenRouter API key；留空时不调用模型
LLM_API_KEY=
LLM_MODEL=stealth/space-bunny-alpha
# 仅供支持 thinking 扩展的其他供应商使用；OpenRouter 保持注释
# LLM_THINKING=disabled
# 可选：启用 A/港/美股证券主数据与行情；新闻接口还需单独权限
TUSHARE_TOKEN=
TUSHARE_NEWS_ENABLED=false
AKSHARE_ENABLED=true
FINNHUB_API_KEY=
FINNHUB_NEWS_ENABLED=false
SEC_EDGAR_ENABLED=true
GDELT_NEWS_ENABLED=true
GDELT_BASE_URL=https://api.gdeltproject.org/api/v2/doc/doc
NEWS_LOOKBACK_HOURS=48
SEMANTIC_CLUSTERING_ENABLED=false
SEMANTIC_CLUSTERING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SEMANTIC_CLUSTERING_THRESHOLD=0.82
SCHEDULER_ENABLED=true
# 美股/港股日线：自选与持仓自动补历史和盘后更新，手动刷新不受此开关影响。
DAILY_BARS_ENABLED=true
INGEST_INTERVAL_MINUTES=30
X_BROWSER_ENABLED=false
X_FETCH_MODE=auto
X_BROWSER_HEADLESS=true
# 未设置时使用系统 / 环境代理；需要独立代理时取消下一行注释
# X_BROWSER_PROXY_URL=http://127.0.0.1:1082
X_FETCH_INTERVAL_HOURS=6
X_LOOKBACK_HOURS=24
X_BROWSER_PROFILE_PATH=./data/x-browser-profile
REQUEST_TIMEOUT_SECONDS=20
AUTO_ANALYZE=true
APP_TIMEZONE=America/New_York
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_DIGEST_TIMEZONE=Asia/Shanghai
TELEGRAM_DIGEST_HOUR=8
TELEGRAM_DIGEST_MINUTE=30
TELEGRAM_DIGEST_HORIZON=5
TELEGRAM_DIGEST_LIMIT=5
TELEGRAM_COMMAND_POLL_SECONDS=5
TELEGRAM_UPDATE_OFFSET_PATH=./data/telegram_update_offset
# 可选：填写手机可访问的网站根地址后，日报会附机会详情链接
PUBLIC_BASE_URL=
